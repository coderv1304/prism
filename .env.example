# Copy to .env and adjust for your machine.
# Never commit the filled-in file. CI/CD injects these values at runtime.

# ── Compose / database ──────────────────────────────────────────────
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=prism
# Host ports. Change these if something already owns 5432/6379 on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Local (npm run dev) uses localhost. Inside Compose the host is `postgres`.
DATABASE_URL=postgresql://prism:change-me-before-you-deploy@localhost:5432/prism?schema=public

# ── Queue ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Host port for the published API container (optional; defaults to 4000).
API_HOST_PORT=4000
# Browser origin allowed to call the API directly (the web app normally uses the BFF).
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
APP_VERSION=1.0.0

# ── Worker ──────────────────────────────────────────────────────────
WORKER_PORT=4001
WORKER_CONCURRENCY=4
# Artificial pause between observable stages, in ms. Set 0 in tests.
JOB_STAGE_DELAY_MS=450

# ── Web ─────────────────────────────────────────────────────────────
# Server-side only: where Next.js forwards /api/v1 requests.
API_INTERNAL_URL=http://localhost:4000
# Baked into metadata at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host port for the published web container (optional; defaults to 3000).
WEB_HOST_PORT=3000
